# PAWS Testing API (Azure Container App) environment, reviewed template.
#
# Copy the values into the Testing Container App once (Portal > Container App > Containers > Environment
# variables, or `az containerapp update --set-env-vars`). Replace every <...> placeholder. The deploy
# workflow only changes the image, PAWS_RELEASE_SHA and PAWS_RUNTIME_TRUST_ANCHOR, and it refuses to
# activate a revision unless `node tools/verify-testing-api-env.js` accepts the app's environment.
#
# Never put a password or key in this file. SQL uses the Testing managed identity (no password in the
# connection string), so PAWS_SQL_CONNECTION_STRING is a plain value and can be verified.
# FIREBASE_SERVICE_ACCOUNT_JSON is optional and, when used, must be a Container App secret reference.

# ---- environment identity ------------------------------------------------------------------
PAWS_ENVIRONMENT=testing
PAWS_TESTING_ENVIRONMENT_ID=<new UUID; the reset tool writes the same value into the database marker>
PAWS_TESTING_SQL_SERVER=<testing-sql-server>.database.windows.net
PAWS_SQL_CONNECTION_STRING=Server=tcp:<testing-sql-server>.database.windows.net,1433;Database=VetMed-Ops;Encrypt=true
PAWS_SQL_MI_CLIENT_ID=<client id of the Testing runtime user-assigned managed identity>
PAWS_SQL_DRIVER=tedious
FIREBASE_PROJECT_ID=<testing firebase project id>

# ---- HTTP ----------------------------------------------------------------------------------
PAWS_API_HOST=0.0.0.0
PAWS_API_PORT=8080
PAWS_API_ALLOW_NON_LOOPBACK=true
PAWS_API_ALLOWED_ORIGINS=https://<testing hosting site>.web.app

# ---- write gates (Testing only; Production gates are owner-managed on the Production host) ----
# Every gate is set explicitly. All are open so ADFAD testers can exercise every implemented workflow;
# server authorization, validation and audit still apply. See deploy/testing/write-gate-matrix.json.
