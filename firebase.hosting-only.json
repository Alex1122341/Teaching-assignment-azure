{
  "hosting": {
    "public": ".firebase-production/app",
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "ignore": [],
    "redirects": [
      {
        "source": "/faculty-dashboard.html",
        "destination": "/index.html",
        "type": 301
      }
    ]
  }
}
