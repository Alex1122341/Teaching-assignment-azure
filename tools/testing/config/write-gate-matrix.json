      "testing": true,
      "personaNote": "Import writes run on the separate import pool; run them as yourself. In Testing the synthetic data can be reset afterwards."
    },
    {
      "gate": "schedulingTaskReview",
      "env": "PAWS_SCHEDULING_TASK_REVIEW_ENABLED",
      "feature": "Scheduling Tasks: review a task",
      "routeSummary": [
