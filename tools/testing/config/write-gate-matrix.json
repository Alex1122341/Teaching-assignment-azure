      "routeSummary": [
        "POST /api/v1/doe/recalculate*"
      ],
      "modules": [
        "server/src/doe/doe-api.js"
      ],
      "testing": true
    },
    {
      "gate": "calendarActivityStage",
      "env": "PAWS_CALENDAR_ACTIVITY_STAGE_ENABLED",
      "feature": "Calendar Activities: stage and preview an import",
      "routeSummary": [
        "POST /api/v1/calendar-activity-imports",
        "POST /api/v1/calendar-activity-imports/{id}/preview"
      ],
      "modules": [
        "server/src/calendar/calendar-activity-api.js"
      ],
      "testing": true,
      "personaNote": "Import writes run on the separate import pool; run them as yourself."
    },
    {
      "gate": "calendarActivityCommit",
      "env": "PAWS_CALENDAR_ACTIVITY_COMMIT_ENABLED",
      "feature": "Calendar Activities: commit a previewed import",
      "routeSummary": [
        "POST /api/v1/calendar-activity-imports/{id}/commit"
      ],
      "modules": [
        "server/src/calendar/calendar-activity-api.js"
      ],
      "testing": true,
      "personaNote": "Import writes run on the separate import pool; run them as yourself."
    },
    {
      "gate": "calendarActivityTime",
      "env": "PAWS_CALENDAR_ACTIVITY_TIME_ENABLED",
      "feature": "Calendar Activities: resolve time evidence",
      "routeSummary": [
