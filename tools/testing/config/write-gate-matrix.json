      "modules": [
        "server/src/doe/doe-api.js"
      ],
      "testing": true
    },
    {
      "gate": "doePolicyPublish",
      "env": "PAWS_DOE_POLICY_PUBLISH_ENABLED",
      "feature": "DOE: publish / retire a Rule Book policy",
      "routeSummary": [
        "POST /api/v1/doe/policies/{id}/publish",
        "POST /api/v1/doe/policies/{id}/lifecycle"
      ],
      "modules": [
        "server/src/doe/doe-api.js"
      ],
      "testing": true
    },
    {
      "gate": "doeRecalculate",
      "env": "PAWS_DOE_RECALC_WRITE_ENABLED",
